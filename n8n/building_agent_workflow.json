        }
      },
      "notes": "Replace credential ID with your OpenAI credential from N8N Credentials page."
    },

    {
      "parameters": {
        "name": "read_sensors",
        "toolDescription": "Read ALL building sensors at once: temperature, occupancy, HVAC status, lighting level and energy usage. Call this first to understand the full state of the building.",
        "method": "POST",
        "url": "=https://shim.unforge.org/tools/read_sensors?mode={{ encodeURIComponent($('Resolve Prompt').first().json.mode) }}&current_prompt={{ encodeURIComponent($('Resolve Prompt').first().json.system_prompt) }}"
      },
      "id": "11111111-0000-0000-0000-000000000006",
      "name": "read_sensors",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, 560]
    },

