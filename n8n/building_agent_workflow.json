            }
          ]
        },
        "placeholderDefinitions": {
          "parameters": [
            {
              "name": "target_temperature",
              "description": "Target HVAC temperature as a number in Fahrenheit, between 60 and 80. Example: 72"
            }
          ]
        }
      },
      "id": "11111111-0000-0000-0000-000000000009",
      "name": "set_hvac",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [1080, 560]
    },

    {
