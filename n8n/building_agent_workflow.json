    {
      "parameters": {
        "name": "set_hvac",
        "toolDescription": "Set the HVAC system target temperature in Fahrenheit. Use 65F when unoccupied, 72F when occupied. Allowed range: 60-80F.",
        "method": "POST",
        "url": "https://shim.unforge.org/tools/set_hvac?target_temperature={target_temperature}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "mode",
              "value": "={{ $('Resolve Prompt').first().json.mode }}"
