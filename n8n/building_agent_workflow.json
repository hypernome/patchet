        "method": "POST",
        "url": "=https://shim.unforge.org/tools/read_occupancy?mode={{ encodeURIComponent($('Resolve Prompt').first().json.mode) }}&current_prompt={{ encodeURIComponent($('Resolve Prompt').first().json.system_prompt) }}"
      },
      "id": "11111111-0000-0000-0000-000000000007",
